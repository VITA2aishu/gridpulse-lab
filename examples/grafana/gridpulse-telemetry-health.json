{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source that scrapes GridPulse Lab",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {
        "defaults": {"unit": "s", "min": 0},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
          "expr": "gridpulse_telemetry_age_seconds",
          "legendFormat": "{{asset_id}}",
          "refId": "A"
        }
      ],
      "title": "Telemetry age by asset",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "gridpulse_active_alarms", "refId": "A"}],
      "title": "Active alarms",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto", "wideLayout": true},
      "targets": [{"expr": "gridpulse_active_incidents", "refId": "A"}],
      "title": "Active synthetic incidents",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 4, "w": 12, "x": 12, "y": 4},
      "id": 4,
      "options": {"displayMode": "gradient", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [
        {
          "expr": "gridpulse_progression_state{status=\"frozen\"}",
          "legendFormat": "{{asset_id}} frozen",
          "refId": "A"
        }
      ],
      "title": "Frozen progression state (1 = frozen)",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 8},
      "id": 5,
      "options": {"displayMode": "lcd", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [
        {
          "expr": "gridpulse_quality_points",
          "legendFormat": "{{quality}}",
          "refId": "A"
        }
      ],
      "title": "Telemetry points by quality",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"decimals": 0, "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 8},
      "id": 6,
      "options": {"displayMode": "basic", "minVizHeight": 10, "minVizWidth": 0, "namePlacement": "auto", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true, "valueMode": "color"},
      "targets": [
        {
          "expr": "gridpulse_progression_state",
          "legendFormat": "{{asset_id}} / {{status}}",
          "refId": "A"
        }
      ],
      "title": "Progression state",
      "type": "bargauge"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["gridpulse", "telemetry", "observability", "energy"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "GridPulse Lab - Telemetry Health",
  "uid": "gridpulse-telemetry-health",
  "version": 1,
  "weekStart": ""
}
